# ===== Base de datos =====
MONGODB_ATLAS=mongodb+srv://usuario:password@cluster.mongodb.net/wraith

# ===== Servidor =====
PORT=3000
# Debe terminar en "/" porque los enlaces se construyen como ${URL_FRONTEND}confirmar/${token}
URL_FRONTEND=https://tu-frontend.vercel.app/

# ===== JWT =====
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ===== Stripe =====
STRIPE_PRIVATE_KEY=tu_clave_secreta_de_stripe

# ===== Correo / SMTP (Brevo) =====
# Brevo: https://www.brevo.com  ->  SMTP & API  ->  pestaña SMTP
#   - SMTP_USER = el login/correo que Brevo muestra en esa pestaña
#   - SMTP_PASS = la "SMTP key" que generas ahí (NO la contraseña de la cuenta)
# Antes el correo no llegaba porque Google bloquea el SMTP de Gmail desde la nube.
# Brevo es un relay transaccional con buena entregabilidad y admite remitente Gmail.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu_login_de_brevo
SMTP_PASS=tu_smtp_key_de_brevo

# Remitente: correo verificado como "sender" en Brevo (puede ser el Gmail).
MAIL_FROM=Wraith - Delta Studio <my.delta.studio@gmail.com>

# --- (Opcional) compatibilidad con la config antigua de Gmail/Mailtrap ---
# Si SMTP_* no está definido, el código usa estas como respaldo:
# HOST_MAILTRAP=
# PORT_MAILTRAP=
# USER_MAILTRAP=
# PASS_MAILTRAP=
