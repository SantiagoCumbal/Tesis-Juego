# ===== Base de datos =====
MONGODB_ATLAS=mongodb+srv://usuario:password@cluster.mongodb.net/wraith

# ===== Servidor =====
PORT=3000
# Debe terminar en "/" porque los enlaces se construyen como ${URL_FRONTEND}confirmar/${token}
URL_FRONTEND=https://tu-frontend.vercel.app/

# ===== JWT =====
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ===== Stripe =====
STRIPE_PRIVATE_KEY=tu_clave_secreta_de_stripe

# ===== Correo / SMTP (Resend recomendado) =====
# Resend: https://resend.com  ->  API Keys  ->  copia la clave (re_...)
# El correo de Gmail dejaba de llegar porque Google bloquea el SMTP de Gmail
# desde la nube. Resend es un proveedor transaccional con buena entregabilidad.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_tu_api_key_de_resend

# Remitente. DEBE ser un dominio verificado en Resend (no puede ser @gmail.com).
# Ej.: "Wraith - Delta Studio <no-reply@tudominio.com>"
# Sin dominio propio puedes usar onboarding@resend.dev SOLO para pruebas
# (únicamente entrega al correo dueño de la cuenta Resend).
MAIL_FROM=Wraith - Delta Studio <onboarding@resend.dev>

# --- (Opcional) compatibilidad con la config antigua de Gmail/Mailtrap ---
# Si SMTP_* no está definido, el código usa estas como respaldo:
# HOST_MAILTRAP=
# PORT_MAILTRAP=
# USER_MAILTRAP=
# PASS_MAILTRAP=
